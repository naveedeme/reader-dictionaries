{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/naveedeme/reader-dictionaries/schema/manifest.schema.json",
  "title": "Reader offline dictionary manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "version",
    "sourceType",
    "sourceLanguage",
    "definitionLanguage",
    "license",
    "databaseFile",
    "databaseSha256",
    "entryCount",
    "minimumAppSchemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sourceType": {
      "enum": [
        "wiktionary",
        "wordnet",
        "freedict"
      ]
    },
    "sourceLanguage": {
      "type": "string",
      "minLength": 2
    },
    "definitionLanguage": {
      "type": "string",
      "minLength": 2
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "licenseFile": {
      "const": "LICENSE.txt"
    },
    "attributionFile": {
      "const": "ATTRIBUTION.md"
    },
    "databaseFile": {
      "const": "dictionary.sqlite"
    },
    "databaseSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "installedSize": {
      "type": "integer",
      "minimum": 1
    },
    "entryCount": {
      "type": "integer",
      "minimum": 1
    },
    "senseCount": {
      "type": "integer",
      "minimum": 1
    },
    "exampleCount": {
      "type": "integer",
      "minimum": 0
    },
    "formCount": {
      "type": "integer",
      "minimum": 0
    },
    "translationCount": {
      "type": "integer",
      "minimum": 0
    },
    "relationCount": {
      "type": "integer",
      "minimum": 0
    },
    "minimumAppSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "archiveFile": {
      "type": "string",
      "minLength": 1
    },
    "builtAt": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object"
    },
    "logicalId": {
      "type": "string",
      "minLength": 1
    },
    "shard": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "index",
        "count",
        "label"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
